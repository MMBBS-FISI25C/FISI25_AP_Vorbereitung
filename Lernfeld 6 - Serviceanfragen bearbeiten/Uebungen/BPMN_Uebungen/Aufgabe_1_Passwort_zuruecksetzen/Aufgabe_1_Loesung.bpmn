<bpmn:collaboration id="Collab_1">
<bpmn:participant id="Pool_U" name="Unternehmen – Passwort zurücksetzen" processRef="Proc_Pool_U" />
</bpmn:collaboration>
<bpmn:process id="Proc_Pool_U" isExecutable="false">
<bpmn:laneSet id="LS_Pool_U">
<bpmn:lane id="Pool_U_L0" name="Mitarbeiter">
<bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Pool_U_L1" name="IT-Support">
<bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s1" name="Passwort vergessen">
<bpmn:outgoing>Flow_1</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:task id="t1" name="Ticket erstellen">
<bpmn:incoming>Flow_1</bpmn:incoming>
<bpmn:outgoing>Flow_2</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="t2" name="Identität prüfen">
<bpmn:incoming>Flow_2</bpmn:incoming>
<bpmn:outgoing>Flow_3</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="g1" name="Identität bestätigt?">
<bpmn:incoming>Flow_3</bpmn:incoming>
<bpmn:outgoing>Flow_4</bpmn:outgoing>
<bpmn:outgoing>Flow_5</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="t4" name="Passwort zurücksetzen">
<bpmn:incoming>Flow_4</bpmn:incoming>
<bpmn:outgoing>Flow_7</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="t3" name="Anfrage ablehnen">
<bpmn:incoming>Flow_5</bpmn:incoming>
<bpmn:outgoing>Flow_6</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="e2" name="Anfrage abgelehnt">
<bpmn:incoming>Flow_6</bpmn:incoming>
</bpmn:endEvent>
<bpmn:task id="t5" name="Neues Passwort festlegen">
<bpmn:incoming>Flow_7</bpmn:incoming>
<bpmn:outgoing>Flow_8</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="e1" name="Zugang wiederhergestellt">
<bpmn:incoming>Flow_8</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s1" targetRef="t1" />
<bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="t2" />
<bpmn:sequenceFlow id="Flow_3" sourceRef="t2" targetRef="g1" />
<bpmn:sequenceFlow id="Flow_4" name="ja" sourceRef="g1" targetRef="t4" />
<bpmn:sequenceFlow id="Flow_5" name="nein" sourceRef="g1" targetRef="t3" />
<bpmn:sequenceFlow id="Flow_6" sourceRef="t3" targetRef="e2" />
<bpmn:sequenceFlow id="Flow_7" sourceRef="t4" targetRef="t5" />
<bpmn:sequenceFlow id="Flow_8" sourceRef="t5" targetRef="e1" />
</bpmn:process>
